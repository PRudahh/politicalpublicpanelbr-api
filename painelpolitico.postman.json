          }
        }
      ]
    },

    {
      "name": "🗳️ Câmara de Vereadores",
      "item": [
        {
          "name": "Listar todos os vereadores",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
