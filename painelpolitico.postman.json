        {
          "name": "Relatório de Gestão Fiscal (RGF)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/municipalities/{{ibge_code}}/finances/fiscal-report",
              "host": ["{{base_url}}"],
