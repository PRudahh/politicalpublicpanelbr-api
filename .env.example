APP_NAME="Painel Político Nacional"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=painel_politico
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── APIs Externas ──────────────────────────────────────────────
TSE_BASE_URL=https://dadosabertos.tse.jus.br
TSE_TIMEOUT=30

SICONFI_BASE_URL=https://apidatalake.tesouro.gov.br/ords/siconfi
SICONFI_TIMEOUT=30

TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
TRANSPARENCIA_API_KEY=
TRANSPARENCIA_TIMEOUT=30

IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1
IBGE_TIMEOUT=15

# ── Rate Limiting ──────────────────────────────────────────────
API_RATE_LIMIT=60
API_RATE_LIMIT_AUTH=300

# ── Sanctum ───────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173

# ── Cache TTLs (em segundos) ───────────────────────────────────
CACHE_TTL_MUNICIPALITY=86400
CACHE_TTL_FINANCES=3600
CACHE_TTL_RANKING=43200
